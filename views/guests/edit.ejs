<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Редактировать гостя</h1>
      <a href="/guests" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <form action="/guests/<%= guest.id %>?_method=PUT" method="post">
        <div class="form-group">
          <label>Имя</label>
          <input type="text" name="name" value="<%= guest.name %>" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" value="<%= guest.email %>" required>
        </div>
        <div class="form-group">
          <label>Телефон</label>
          <input type="text" name="phone" value="<%= guest.phone || '' %>">
        </div>
        <div class="form-group">
          <label>Город</label>
          <input type="text" name="city" value="<%= guest.city || '' %>">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Сохранить</button>
          <a href="/guests" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
