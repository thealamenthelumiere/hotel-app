<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Гости</h1>
      <% if (locals.isAdmin) { %>
        <a href="/guests/add" class="btn btn--primary">+ Добавить гостя</a>
      <% } %>
    </div>
    <div class="card-list">
      <% if (guests && guests.length) { %>
        <% guests.forEach(guest => { %>
          <div class="card">
            <div class="card__info">
              <p class="card__title"><%= guest.name %></p>
              <p class="card__sub"><%= guest.email %><% if (guest.phone) { %> · <%= guest.phone %><% } %></p>
            </div>
            <div class="card__actions">
              <a href="/guests/<%= guest.id %>" class="btn btn--outline btn--sm">Просмотр</a>
              <% if (locals.isAdmin) { %>
                <a href="/guests/<%= guest.id %>/edit" class="btn btn--outline btn--sm">Изменить</a>
                <form action="/guests/<%= guest.id %>?_method=DELETE" method="post" onsubmit="return confirm('Удалить гостя?')">
                  <button type="submit" class="btn btn--danger btn--sm">Удалить</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>Гости не найдены.</p>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
