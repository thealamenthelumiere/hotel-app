<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Номера</h1>
      <% if (locals.isAdmin) { %>
        <a href="/rooms/add" class="btn btn--primary">+ Добавить номер</a>
      <% } %>
    </div>
    <div class="card-list">
      <% if (rooms && rooms.length) { %>
        <% rooms.forEach(room => { %>
          <div class="card">
            <div class="card__info">
              <p class="card__title">Номер <%= room.number %> — <%= room.type %></p>
              <p class="card__sub"><%= room.pricePerNight %> руб/ночь · Вместимость: <%= room.capacity %> чел.</p>
            </div>
            <div class="card__actions">
              <a href="/rooms/<%= room.id %>" class="btn btn--outline btn--sm">Просмотр</a>
              <% if (locals.isAdmin) { %>
                <a href="/rooms/<%= room.id %>/edit" class="btn btn--outline btn--sm">Изменить</a>
                <form action="/rooms/<%= room.id %>?_method=DELETE" method="post" onsubmit="return confirm('Удалить номер?')">
                  <button type="submit" class="btn btn--danger btn--sm">Удалить</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>Номера не найдены.</p>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
