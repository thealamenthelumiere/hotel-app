<%- include('../partials/header') %>
<h1>Список номеров</h1>
<a href="/rooms/add">Добавить номер</a>
<ul>
  <% rooms.forEach(room => { %>
    <li>
      <a href="/rooms/<%= room.id %>">Номер <%= room.number %></a> (<%= room.type %>) - <%= room.pricePerNight %> руб./ночь
      <form action="/rooms/<%= room.id %>?_method=DELETE" method="post" style="display:inline;">
        <button type="submit">Удалить</button>
      </form>
      <a href="/rooms/<%= room.id %>/edit">Редактировать</a>
    </li>
  <% }) %>
</ul>
<%- include('../partials/footer') %>