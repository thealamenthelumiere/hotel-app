<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Редактировать номер <%= room.number %></h1>
<form action="/rooms/<%= room.id %>?_method=PUT" method="post">
  <label>Номер: <input type="text" name="number" value="<%= room.number %>" required></label>
  <label>Тип: <input type="text" name="type" value="<%= room.type %>" required></label>
  <label>Цена: <input type="number" step="0.01" name="pricePerNight" value="<%= room.pricePerNight %>" required></label>
  <label>Вместимость: <input type="number" name="capacity" value="<%= room.capacity %>" required></label>
  <label>Описание: <textarea name="description"><%= room.description || '' %></textarea></label>
  <button type="submit">Сохранить</button>
</form>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>