<%- include('../partials/header') %>
<h1>Редактировать номер <%= room.number %></h1>
<form action="/rooms/<%= room.id %>?_method=PUT" method="post">
  <div>
    <label>Номер комнаты:</label>
    <input type="text" name="number" value="<%= room.number %>" required>
  </div>
  <div>
    <label>Тип:</label>
    <input type="text" name="type" value="<%= room.type %>" required>
  </div>
  <div>
    <label>Цена за ночь (руб):</label>
    <input type="number" step="0.01" name="pricePerNight" value="<%= room.pricePerNight %>" required>
  </div>
  <div>
    <label>Вместимость:</label>
    <input type="number" name="capacity" value="<%= room.capacity %>" required>
  </div>
  <div>
    <label>Описание:</label>
    <textarea name="description"><%= room.description || '' %></textarea>
  </div>
  <button type="submit">Сохранить</button>
</form>
<%- include('../partials/footer') %>