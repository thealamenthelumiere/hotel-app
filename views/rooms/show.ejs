<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Номер <%= room.number %></h1>
      <a href="/rooms" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <p><strong>Тип:</strong> <%= room.type %></p>
      <p><strong>Цена:</strong> <%= room.pricePerNight %> руб/ночь</p>
      <p><strong>Вместимость:</strong> <%= room.capacity %> чел.</p>
      <p><strong>Описание:</strong> <%= room.description || 'Не указано' %></p>
      <div class="form-actions">
        <% if (locals.isAuthenticated) { %>
          <a href="/bookings/add?roomId=<%= room.id %>" class="btn btn--primary">Забронировать</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn--primary">Войдите чтобы забронировать</a>
        <% } %>
        <% if (locals.isAdmin) { %>
          <a href="/rooms/<%= room.id %>/edit" class="btn btn--outline">Редактировать</a>
          <form action="/rooms/<%= room.id %>?_method=DELETE" method="post" onsubmit="return confirm('Удалить номер?')">
            <button type="submit" class="btn btn--danger">Удалить</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
