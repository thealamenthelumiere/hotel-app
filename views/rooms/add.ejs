<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Добавить номер</h1>
      <a href="/rooms" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <form action="/rooms" method="post">
        <div class="form-group">
          <label>Номер комнаты</label>
          <input type="text" name="number" required placeholder="101">
        </div>
        <div class="form-group">
          <label>Тип</label>
          <input type="text" name="type" required placeholder="Стандарт / Люкс">
        </div>
        <div class="form-group">
          <label>Цена за ночь (руб.)</label>
          <input type="number" step="0.01" name="pricePerNight" required placeholder="5000">
        </div>
        <div class="form-group">
          <label>Вместимость (чел.)</label>
          <input type="number" name="capacity" required placeholder="2">
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea name="description" placeholder="Описание номера..."></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Создать</button>
          <a href="/rooms" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
