<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Добавить номер</h1>
<form action="/rooms" method="post">
  <label>Номер комнаты: <input type="text" name="number" required></label>
  <label>Тип: <input type="text" name="type" required></label>
  <label>Цена за ночь: <input type="number" step="0.01" name="pricePerNight" required></label>
  <label>Вместимость: <input type="number" name="capacity" required></label>
  <label>Описание: <textarea name="description"></textarea></label>
  <button type="submit">Создать</button>
</form>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>