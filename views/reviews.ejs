<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <div class="container">
    <h2>Отзывы наших гостей</h2>
    <div id="reviews-container">
      <div id="preloader" class="preloader">Загрузка отзывов...</div>
    </div>
    <button id="load-reviews" class="btn btn--outline">Загрузить отзывы</button>

    <section id="add-review" style="margin-top:32px;">
      <h2>Оставить отзыв</h2>
      <form id="add-review-form" class="form-card" style="max-width:480px;">
        <div class="form-group">
          <input type="text" id="new-review-name-input" placeholder="Ваше имя" required>
        </div>
        <div class="form-group">
          <input type="email" id="new-review-email-input" placeholder="Ваш email" required>
        </div>
        <div class="form-group">
          <textarea id="new-review-body-input" placeholder="Ваш отзыв" required></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Отправить отзыв</button>
        </div>
      </form>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/modal') %>
<%- include('partials/scripts') %>
<script src="/reviews.js" defer></script>