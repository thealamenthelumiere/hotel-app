<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1><%= service.name %></h1>
<p>Цена: <%= service.price %> руб.</p>
<p>Описание: <%= service.description || 'Нет' %></p>
<p>Длительность: <%= service.duration ? service.duration + ' мин.' : 'Не указана' %></p>
<a href="/services/<%= service.id %>/edit">Редактировать</a>
<form action="/services/<%= service.id %>?_method=DELETE" method="post" style="display:inline;" onsubmit="return confirm('Удалить услугу?')">
  <button type="submit">Удалить</button>
</form>
<a href="/services">Назад к списку</a>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>