<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Редактировать услугу</h1>
<form action="/services/<%= service.id %>?_method=PUT" method="post">
  <div>
    <label>Название:</label>
    <input type="text" name="name" value="<%= service.name %>" required>
  </div>
  <div>
    <label>Цена (руб):</label>
    <input type="number" step="0.01" name="price" value="<%= service.price %>" required>
  </div>
  <div>
    <label>Описание:</label>
    <textarea name="description"><%= service.description || '' %></textarea>
  </div>
  <div>
    <label>Длительность (мин):</label>
    <input type="number" name="duration" value="<%= service.duration || '' %>">
  </div>
  <button type="submit">Сохранить</button>
</form>
<a href="/services">Назад к списку</a>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>