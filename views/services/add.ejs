<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Добавить услугу</h1>
      <a href="/services" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <form action="/services" method="post">
        <div class="form-group">
          <label>Название</label>
          <input type="text" name="name" required placeholder="Спа-процедура">
        </div>
        <div class="form-group">
          <label>Цена (руб.)</label>
          <input type="number" step="0.01" name="price" required placeholder="3000">
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea name="description" placeholder="Описание услуги..."></textarea>
        </div>
        <div class="form-group">
          <label>Длительность (мин.)</label>
          <input type="number" name="duration" placeholder="60">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Создать</button>
          <a href="/services" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
