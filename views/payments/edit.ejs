<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Редактировать платёж</h1>
      <a href="/payments/<%= payment.id %>" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <form action="/payments/<%= payment.id %>?_method=PUT" method="post">
        <div class="form-group">
          <label>Бронирование</label>
          <select name="bookingId">
            <option value="<%= payment.booking ? payment.booking.id : '' %>">
              <%= payment.booking ? '#' + payment.booking.id.substring(0,8) + '… (текущее)' : '— не привязано —' %>
            </option>
            <% bookings.forEach(b => { %>
              <option value="<%= b.id %>">
                #<%= b.id.substring(0,8) %> — <%= b.guest ? b.guest.name : '?' %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Сумма (руб.)</label>
          <input type="number" step="0.01" name="amount" value="<%= payment.amount %>" required>
        </div>
        <div class="form-group">
          <label>Способ оплаты</label>
          <select name="method">
            <option value="cash" <%= payment.method === 'cash' ? 'selected' : '' %>>Наличные</option>
            <option value="card" <%= payment.method === 'card' ? 'selected' : '' %>>Карта</option>
            <option value="online" <%= payment.method === 'online' ? 'selected' : '' %>>Онлайн</option>
          </select>
        </div>
        <div class="form-group">
          <label>Статус</label>
          <select name="status">
            <option value="pending" <%= payment.status === 'pending' ? 'selected' : '' %>>Ожидает</option>
            <option value="paid" <%= payment.status === 'paid' ? 'selected' : '' %>>Оплачено</option>
            <option value="refunded" <%= payment.status === 'refunded' ? 'selected' : '' %>>Возврат</option>
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Сохранить</button>
          <a href="/payments/<%= payment.id %>" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
