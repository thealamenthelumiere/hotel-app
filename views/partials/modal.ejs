<div id="modal" class="modal">
  <div class="modal-content">
    <span class="close-button">&times;</span>
    <h2>Бронирование номера</h2>

    <div id="modal-auth-msg" style="display:none;">
      <p>Для бронирования необходимо <a href="/auth/login">войти в аккаунт</a>.</p>
    </div>

    <form id="booking-form" style="display:none;">
      <div class="form-group">
        <label>Номер</label>
        <select id="booking-room" required>
          <option value="">— Загрузка... —</option>
        </select>
      </div>
      <div class="form-group">
        <label>Дата заезда</label>
        <input type="date" id="booking-checkin" required>
      </div>
      <div class="form-group">
        <label>Дата выезда</label>
        <input type="date" id="booking-checkout" required>
      </div>
      <div id="booking-error" class="alert alert--error" style="display:none;"></div>
      <div id="booking-success" class="alert alert--success" style="display:none;"></div>
      <div class="form-actions">
        <button type="submit" class="btn btn--primary" id="booking-submit">Забронировать</button>
      </div>
    </form>
  </div>
</div>
