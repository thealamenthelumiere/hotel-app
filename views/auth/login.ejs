<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Вход</h1>
    </div>
    <div class="form-card" style="max-width:420px;margin:0 auto;">
      <% if (locals.error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>
      <form action="/auth/login" method="post">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" required placeholder="admin@hotel.ru" autofocus>
        </div>
        <div class="form-group">
          <label>Пароль</label>
          <input type="password" name="password" required placeholder="••••••">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Войти</button>
          <a href="/auth/register" class="btn btn--outline">Регистрация</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
