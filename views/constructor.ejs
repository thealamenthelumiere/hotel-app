<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head') %>
  <title>Конструктор расписания</title>
</head>
<body>
  <%- include('partials/header') %>
  <main>
    <div class="container">
      <h2>Конструктор досуга</h2>
      <form id="schedule-form">
        <label>Мероприятий в день: <input type="number" name="eventsPerDay" value="3"></label>
        <label>Язык: 
          <select name="language">
            <option value="ru">Русский</option>
            <option value="en">English</option>
          </select>
        </label>
        <fieldset>
          <legend>Выберите досуги:</legend>
          <label><input type="checkbox" name="leisure" value="spa"> Спа</label>
          <label><input type="checkbox" name="leisure" value="yoga"> Йога</label>
          <label><input type="checkbox" name="leisure" value="tour"> Экскурсия</label>
        </fieldset>
        <button type="submit">Создать расписание</button>
      </form>
      <div id="schedule-output"></div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <%- include('partials/modal') %>
  <%- include('partials/scripts') %>
  <script src="/js/constructor.js" defer></script>
</body>
</html>