<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Редактировать бронирование</h1>
<form action="/bookings/<%= booking.id %>/update" method="post">
  <label>Гость:
    <select name="guestId">
      <% guests.forEach(g => { %>
        <option value="<%= g.id %>" <%= (booking.guest && booking.guest.id === g.id) ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>
  </label>
  <!-- остальные поля аналогично add, но с атрибутом value или selected -->
  <button type="submit">Сохранить</button>
</form>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>