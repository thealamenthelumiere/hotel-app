<%- include('../partials/header') %>
<h1>Редактировать бронирование</h1>

<form action="/bookings/<%= booking.id %>?_method=PUT" method="post">
  <div>
    <label>Гость:</label>
    <select name="guestId" required>
      <% guests.forEach(guest => { %>
        <option value="<%= guest.id %>" <%= guest.id === booking.guest?.id ? 'selected' : '' %>>
          <%= guest.name %>
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>Номер:</label>
    <select name="roomId" required>
      <% rooms.forEach(room => { %>
        <option value="<%= room.id %>" <%= room.id === booking.room?.id ? 'selected' : '' %>>
          №<%= room.number %> (<%= room.type %>) – <%= room.pricePerNight %> руб./ночь
        </option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>Дата заезда:</label>
    <input type="date" name="checkInDate" value="<%= new Date(booking.checkInDate).toISOString().split('T')[0] %>" required>
  </div>

  <div>
    <label>Дата выезда:</label>
    <input type="date" name="checkOutDate" value="<%= new Date(booking.checkOutDate).toISOString().split('T')[0] %>" required>
  </div>

  <div>
    <label>Статус:</label>
    <select name="status">
      <option value="pending" <%= booking.status === 'pending' ? 'selected' : '' %>>Ожидает</option>
      <option value="confirmed" <%= booking.status === 'confirmed' ? 'selected' : '' %>>Подтверждено</option>
      <option value="cancelled" <%= booking.status === 'cancelled' ? 'selected' : '' %>>Отменено</option>
      <option value="completed" <%= booking.status === 'completed' ? 'selected' : '' %>>Завершено</option>
    </select>
  </div>

  <div>
    <label>Доп. услуги:</label>
    <% services.forEach(service => { %>
      <div>
        <input type="checkbox" name="serviceIds" value="<%= service.id %>" 
          <%= booking.services?.some(s => s.id === service.id) ? 'checked' : '' %>>
        <label><%= service.name %> (+<%= service.price %> руб.)</label>
      </div>
    <% }) %>
  </div>

  <button type="submit">Сохранить</button>
</form>

<a href="/bookings">Отмена</a>
<%- include('../partials/footer') %>