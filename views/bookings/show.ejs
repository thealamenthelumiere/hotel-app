<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Детали бронирования</h1>
<p><strong>ID:</strong> <%= booking.id %></p>
<p><strong>Гость:</strong> <%= booking.guest ? booking.guest.name : '' %> (<%= booking.guest ? booking.guest.email : '' %>)</p>
<p><strong>Номер:</strong> №<%= booking.room ? booking.room.number : '' %>, тип: <%= booking.room ? booking.room.type : '' %></p>
<p><strong>Заезд:</strong> <%= new Date(booking.checkInDate).toLocaleDateString() %></p>
<p><strong>Выезд:</strong> <%= new Date(booking.checkOutDate).toLocaleDateString() %></p>
<p><strong>Статус:</strong> <%= booking.status %></p>
<p><strong>Сумма:</strong> <%= booking.totalPrice %> руб.</p>
<% if (booking.services && booking.services.length) { %>
  <h3>Услуги:</h3>
  <ul>
    <% booking.services.forEach(s => { %>
      <li><%= s.name %> – <%= s.price %> руб.</li>
    <% }) %>
  </ul>
<% } %>
<a href="/bookings">Назад</a>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>