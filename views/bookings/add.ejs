<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <h1 class="page__title">Новое бронирование</h1>
      <a href="/bookings" class="btn btn--outline">← Назад</a>
    </div>
    <div class="form-card">
      <form action="/bookings" method="post">

        <% if (locals.isAdmin) { %>
          <div class="form-group">
            <label>Гость</label>
            <select name="guestId" required>
              <option value="">— Выберите гостя —</option>
              <% guests.forEach(g => { %>
                <option value="<%= g.id %>"><%= g.name %> (<%= g.email %>)</option>
              <% }) %>
            </select>
          </div>
        <% } else { %>
          <input type="hidden" name="guestId" value="<%= currentGuest ? currentGuest.id : '' %>">
          <div class="form-group">
            <label>Гость</label>
            <input type="text" value="<%= currentGuest ? currentGuest.name : user %>" disabled style="background:#f5f5f5;">
          </div>
        <% } %>

        <div class="form-group">
          <label>Номер</label>
          <select name="roomId" required>
            <option value="">— Выберите номер —</option>
            <% rooms.forEach(r => { %>
              <option value="<%= r.id %>" <%= locals.preselectedRoomId === r.id ? 'selected' : '' %>>
                №<%= r.number %> — <%= r.type %>, <%= r.pricePerNight %> руб/ночь
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Дата заезда</label>
          <input type="date" name="checkInDate" required>
        </div>

        <div class="form-group">
          <label>Дата выезда</label>
          <input type="date" name="checkOutDate" required>
        </div>

        <% if (locals.isAdmin) { %>
          <div class="form-group">
            <label>Статус</label>
            <select name="status">
              <option value="pending">Ожидает</option>
              <option value="confirmed">Подтверждено</option>
              <option value="cancelled">Отменено</option>
            </select>
          </div>
        <% } %>

        <% if (services && services.length) { %>
          <div class="form-group">
            <label>Дополнительные услуги</label>
            <% services.forEach(s => { %>
              <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;font-weight:normal;">
                <input type="checkbox" name="serviceIds" value="<%= s.id %>">
                <%= s.name %> (+<%= s.price %> руб.)
              </label>
            <% }) %>
          </div>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Забронировать</button>
          <a href="/bookings" class="btn btn--outline">Отмена</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
