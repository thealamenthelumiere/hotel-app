<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Новое бронирование</h1>
<form action="/bookings" method="post">
  <label>Гость: 
    <select name="guestId" required>
      <option value="">--Выберите--</option>
      <% guests.forEach(g => { %>
        <option value="<%= g.id %>"><%= g.name %></option>
      <% }) %>
    </select>
  </label>
  <label>Номер:
    <select name="roomId" required>
      <option value="">--Выберите--</option>
      <% rooms.forEach(r => { %>
        <option value="<%= r.id %>">№<%= r.number %> – <%= r.pricePerNight %> руб.</option>
      <% }) %>
    </select>
  </label>
  <label>Заезд: <input type="date" name="checkInDate" required></label>
  <label>Выезд: <input type="date" name="checkOutDate" required></label>
  <label>Статус:
    <select name="status">
      <option value="pending">Ожидает</option>
      <option value="confirmed">Подтверждено</option>
    </select>
  </label>
  <fieldset>
    <legend>Доп. услуги</legend>
    <% services.forEach(s => { %>
      <label><input type="checkbox" name="serviceIds" value="<%= s.id %>"> <%= s.name %> (+<%= s.price %>)</label>
    <% }) %>
  </fieldset>
  <button type="submit">Создать</button>
</form>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>