<%- include('../partials/head') %>
<%- include('../partials/header') %>
<h1>Бронирования</h1>
<a href="/bookings/add">Добавить бронирование</a>
<table border="1">
  <thead>
    <tr><th>ID</th><th>Гость</th><th>Номер</th><th>Заезд</th><th>Выезд</th><th>Статус</th><th>Сумма</th><th>Действия</th></tr>
  </thead>
  <tbody>
    <% bookings.forEach(booking => { %>
      <tr>
        <td><%= String(booking.id).substring(0,6) %>...</td>
        <td><%= booking.guest ? booking.guest.name : '' %></td>
        <td><%= booking.room ? booking.room.number : '' %></td>
        <td><%= new Date(booking.checkInDate).toLocaleDateString() %></td>
        <td><%= new Date(booking.checkOutDate).toLocaleDateString() %></td>
        <td><%= booking.status %></td>
        <td><%= booking.totalPrice %></td>
        <td>
          <a href="/bookings/<%= booking.id %>">Просмотр</a>
          <a href="/bookings/<%= booking.id %>/edit">Ред.</a>
          <form action="/bookings/<%= booking.id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('Удалить?')">
            <button type="submit">Удалить</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>